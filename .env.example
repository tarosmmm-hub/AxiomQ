# Copy to .env and adjust. Every backend variable uses the AXIOMQ_ prefix.
# Never commit a real .env file.

# --- runtime -----------------------------------------------------------------------------------
AXIOMQ_ENV=development                     # development | test | production
AXIOMQ_DATABASE_URL=postgresql+psycopg://axiomq:axiomq@localhost:5432/axiomq
AXIOMQ_REDIS_URL=redis://localhost:6379/0

# Signs CSRF tokens and pseudonymises analytics/audit ids. >= 32 chars; REQUIRED in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AXIOMQ_SECRET_KEY=dev-insecure-secret-change-me-0123456789abcdef

# Public URL of the web app (used in email links).
AXIOMQ_FRONTEND_URL=http://localhost:3000

# --- sessions & auth ---------------------------------------------------------------------------
AXIOMQ_COOKIE_SECURE=false                 # must be true in production (HTTPS)
AXIOMQ_SESSION_TTL_HOURS=336
AXIOMQ_PASSWORD_RESET_TTL_MINUTES=30
AXIOMQ_EMAIL_VERIFICATION_TTL_HOURS=48
AXIOMQ_REQUIRE_EMAIL_VERIFICATION=true     # verified email required to run backtests (Phase 4)

# Reverse proxies in front of the API that APPEND the client IP to X-Forwarded-For (e.g. your load
# balancer). The Next.js proxy forwards the header unchanged, so it does not count.
# 0 = ignore X-Forwarded-For (safe default; rate limits then key on the direct peer address).
AXIOMQ_TRUSTED_PROXY_HOPS=0

# --- email -------------------------------------------------------------------------------------
AXIOMQ_EMAIL_BACKEND=console               # console | smtp (production requires smtp)
AXIOMQ_EMAIL_FROM="AxiomQ <no-reply@axiomq.local>"
AXIOMQ_SMTP_HOST=localhost                 # Mailpit in development (UI on http://localhost:8025)
AXIOMQ_SMTP_PORT=1025
AXIOMQ_SMTP_USERNAME=
AXIOMQ_SMTP_PASSWORD=
AXIOMQ_SMTP_STARTTLS=false

# --- rate limiting -----------------------------------------------------------------------------
AXIOMQ_RATE_LIMIT_BACKEND=redis            # redis | memory (memory = single-process dev only)

# --- logging -----------------------------------------------------------------------------------
AXIOMQ_LOG_LEVEL=INFO
AXIOMQ_LOG_JSON=true

# --- development seed --------------------------------------------------------------------------
AXIOMQ_DEMO_PASSWORD=axiomq-demo-password

# --- frontend (Next.js server) -----------------------------------------------------------------
AXIOMQ_API_URL=http://localhost:8000       # where src/proxy.ts forwards /api/*
